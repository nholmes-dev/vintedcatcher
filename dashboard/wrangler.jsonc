
{
  "name": "vintedcatcher",
  "main": "./worker/index.js",
  "compatibility_date": "2026-10-30",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vintedcatcher",
      "database_id": "f48b21de-9a93-4104-b8ec-980c02e6cabf"
    }
  ]
}
